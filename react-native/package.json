{
  "name": "@masko/player-react-native",
  "version": "0.1.16",
  "description": "Plays Masko mascots in React Native and Expo apps, with the Masko player for iOS and Android.",
  "license": "MIT",
  "author": "Masko",
  "homepage": "https://masko.ai/docs/player",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masko-ai/masko-player.git",
    "directory": "react-native"
  },
  "bugs": {
    "url": "https://github.com/masko-ai/masko-player/issues"
  },
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "react-native": "src/index.ts",
  "files": [
    "build",
    "src",
    "!src/**/__tests__",
    "ios",
    "android",
    "!android/build",
    "!android/.gradle",
    "expo-module.config.json",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "jest",
    "prepack": "node scripts/vendor.mjs && npm run build"
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "19.1.17",
    "babel-preset-expo": "54.0.12",
    "eslint": "9.39.5",
    "eslint-config-expo": "10.0.0",
    "expo": "54.0.38",
    "jest": "29.7.0",
    "jest-expo": "54.0.18",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-test-renderer": "19.1.0",
    "typescript": "5.9.3"
  },
  "keywords": [
    "masko",
    "mascot",
    "animation",
    "video",
    "react-native",
    "expo",
    "ios",
    "android"
  ]
}
